# Copiar a .env y cambiar todas las contraseñas (en el VPS: chmod 600 .env).
# Generar contraseñas con: openssl rand -hex 24

# MySQL de la app (aula_app)
MYSQL_APP_ROOT_PASSWORD=cambiar
APP_DB_USER=aula
APP_DB_PASSWORD=cambiar

# MySQL de sandboxes (consola de estudiantes)
MYSQL_SBX_ROOT_PASSWORD=cambiar
SBX_ADMIN_USER=sbx_admin
SBX_ADMIN_PASSWORD=cambiar
